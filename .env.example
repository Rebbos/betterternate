# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set these in Project → Settings → Environment Variables.

# Public (sent to the browser; must start with VITE_).
# Cloudflare Turnstile always-pass TEST site key. Production: your real site key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server-only (used by /api functions; never sent to the browser).
# Cloudflare Turnstile always-pass TEST secret. Production: your real secret key.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Postgres connection string (set automatically by the Neon integration on Vercel).
# Leave empty locally to just log submissions instead of storing them.
DATABASE_URL=
